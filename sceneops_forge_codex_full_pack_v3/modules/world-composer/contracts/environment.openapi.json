{
  "openapi": "3.1.0",
  "info": {
    "title": "SceneOps Environment Scenes",
    "version": "0.1.0"
  },
  "paths": {
    "/api/environment-scenes/{project_id}": {
      "get": {
        "tags": [
          "environment-scenes"
        ],
        "summary": "Get Scene",
        "operationId": "getEnvironmentScene",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Project Id"
            }
          },
          {
            "name": "version",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Version"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvironmentScene"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/environment-scenes/{project_id}/objects": {
      "post": {
        "tags": [
          "environment-scenes"
        ],
        "summary": "Place Object",
        "operationId": "placeEnvironmentObject",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Project Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ManualPlacementRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvironmentScene"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/environment-scenes/{project_id}/objects/{object_id}": {
      "put": {
        "tags": [
          "environment-scenes"
        ],
        "summary": "Transform Object",
        "operationId": "transformEnvironmentObject",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Project Id"
            }
          },
          {
            "name": "object_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Object Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransformObjectRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvironmentScene"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "environment-scenes"
        ],
        "summary": "Remove Object",
        "operationId": "removeEnvironmentObject",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Project Id"
            }
          },
          {
            "name": "object_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Object Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RemoveObjectRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvironmentScene"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/environment-scenes/{project_id}/ai-build": {
      "post": {
        "tags": [
          "environment-scenes"
        ],
        "summary": "Ai Build",
        "operationId": "buildEnvironmentWithAi",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Project Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AiBuildRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AiBuildResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/project-assets": {
      "get": {
        "tags": [
          "project-asset-library"
        ],
        "summary": "List Assets",
        "operationId": "listProjectAssets",
        "parameters": [
          {
            "name": "project_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "title": "Project Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProjectAssetEntry"
                  },
                  "title": "Response Listprojectassets"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/project-assets/{entry_id}": {
      "get": {
        "tags": [
          "project-asset-library"
        ],
        "summary": "Get Asset",
        "operationId": "getProjectAsset",
        "parameters": [
          {
            "name": "entry_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Entry Id"
            }
          },
          {
            "name": "project_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "title": "Project Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectAssetEntry"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "project-asset-library"
        ],
        "summary": "Rename Asset",
        "operationId": "renameProjectAsset",
        "parameters": [
          {
            "name": "entry_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Entry Id"
            }
          },
          {
            "name": "project_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "title": "Project Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenameProjectAssetRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectAssetEntry"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AiBuildRequest": {
        "properties": {
          "request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,120}$",
            "title": "Request Id"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Version"
          },
          "prompt": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Prompt"
          },
          "retry_failed": {
            "type": "boolean",
            "title": "Retry Failed",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "expected_version",
          "prompt"
        ],
        "title": "AiBuildRequest"
      },
      "AiBuildResult": {
        "properties": {
          "scene": {
            "$ref": "#/components/schemas/EnvironmentScene"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "reused": {
            "type": "boolean",
            "title": "Reused",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "scene",
          "summary",
          "provider",
          "model"
        ],
        "title": "AiBuildResult"
      },
      "EnvironmentMessage": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "role",
          "text"
        ],
        "title": "EnvironmentMessage"
      },
      "EnvironmentObject": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "asset_id": {
            "type": "string",
            "title": "Asset Id"
          },
          "asset_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Asset Version"
          },
          "source_asset_id": {
            "type": "string",
            "title": "Source Asset Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "transform": {
            "$ref": "#/components/schemas/EnvironmentTransform"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "asset_id",
          "asset_version",
          "source_asset_id",
          "title",
          "transform"
        ],
        "title": "EnvironmentObject"
      },
      "EnvironmentScene": {
        "properties": {
          "scene_id": {
            "type": "string",
            "title": "Scene Id"
          },
          "project_id": {
            "type": "string",
            "title": "Project Id"
          },
          "version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Version"
          },
          "objects": {
            "items": {
              "$ref": "#/components/schemas/EnvironmentObject"
            },
            "type": "array",
            "maxItems": 200,
            "title": "Objects"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/EnvironmentMessage"
            },
            "type": "array",
            "maxItems": 200,
            "title": "History"
          },
          "scale_profile": {
            "$ref": "#/components/schemas/WorldScaleProfile"
          },
          "mode": {
            "type": "string",
            "const": "live",
            "title": "Mode",
            "default": "live"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "scene_id",
          "project_id",
          "version"
        ],
        "title": "EnvironmentScene"
      },
      "EnvironmentTransform": {
        "properties": {
          "position_m": {
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array",
            "maxItems": 3,
            "minItems": 3,
            "title": "Position M",
            "default": [
              0.0,
              0.0,
              0.0
            ]
          },
          "rotation_y_deg": {
            "type": "number",
            "title": "Rotation Y Deg",
            "default": 0.0
          },
          "scale": {
            "type": "number",
            "maximum": 100.0,
            "exclusiveMinimum": 0.01,
            "title": "Scale",
            "default": 1.0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "EnvironmentTransform"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ManualPlacementRequest": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Version"
          },
          "asset_id": {
            "type": "string",
            "minLength": 1,
            "title": "Asset Id"
          },
          "asset_version": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Asset Version"
          },
          "position_m": {
            "anyOf": [
              {
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array",
                "maxItems": 3,
                "minItems": 3
              },
              {
                "type": "null"
              }
            ],
            "title": "Position M"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_version",
          "asset_id"
        ],
        "title": "ManualPlacementRequest"
      },
      "ProjectAssetEntry": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "project_id": {
            "type": "string",
            "title": "Project Id"
          },
          "card_id": {
            "type": "string",
            "title": "Card Id"
          },
          "source_asset_id": {
            "type": "string",
            "title": "Source Asset Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "source_title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Title"
          },
          "modeling_session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Modeling Session Id"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "import",
              "generated"
            ],
            "title": "Source Type"
          },
          "category": {
            "type": "string",
            "const": "model",
            "title": "Category",
            "default": "model"
          },
          "current_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Current Version"
          },
          "versions": {
            "items": {
              "$ref": "#/components/schemas/ProjectAssetVersion"
            },
            "type": "array",
            "minItems": 1,
            "title": "Versions"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "project_id",
          "card_id",
          "source_asset_id",
          "title",
          "source_type",
          "current_version",
          "versions"
        ],
        "title": "ProjectAssetEntry"
      },
      "ProjectAssetVersion": {
        "properties": {
          "source_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Source Version"
          },
          "dimensions_m": {
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array",
            "maxItems": 3,
            "minItems": 3,
            "title": "Dimensions M"
          },
          "vertex_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Vertex Count"
          },
          "triangle_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Triangle Count"
          },
          "blend_path": {
            "type": "string",
            "minLength": 1,
            "title": "Blend Path"
          },
          "preview_path": {
            "type": "string",
            "minLength": 1,
            "title": "Preview Path"
          },
          "fbx_path": {
            "type": "string",
            "minLength": 1,
            "title": "Fbx Path"
          },
          "operation": {
            "type": "string",
            "enum": [
              "import",
              "generate",
              "normalize"
            ],
            "title": "Operation"
          },
          "saved_at": {
            "type": "string",
            "title": "Saved At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_version",
          "dimensions_m",
          "vertex_count",
          "triangle_count",
          "blend_path",
          "preview_path",
          "fbx_path",
          "operation"
        ],
        "title": "ProjectAssetVersion"
      },
      "RemoveObjectRequest": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_version"
        ],
        "title": "RemoveObjectRequest"
      },
      "RenameProjectAssetRequest": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 24,
            "minLength": 1,
            "title": "Title"
          },
          "expected_updated_at": {
            "type": "string",
            "title": "Expected Updated At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "expected_updated_at"
        ],
        "title": "RenameProjectAssetRequest"
      },
      "TransformObjectRequest": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Version"
          },
          "transform": {
            "$ref": "#/components/schemas/EnvironmentTransform"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_version",
          "transform"
        ],
        "title": "TransformObjectRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WorldScaleProfile": {
        "properties": {
          "unit": {
            "type": "string",
            "const": "meter",
            "title": "Unit",
            "default": "meter"
          },
          "up_axis": {
            "type": "string",
            "const": "Y",
            "title": "Up Axis",
            "default": "Y"
          },
          "handedness": {
            "type": "string",
            "const": "right",
            "title": "Handedness",
            "default": "right"
          },
          "grid_step_m": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Grid Step M",
            "default": 1.0
          },
          "reference_human_height_m": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Reference Human Height M",
            "default": 1.8
          },
          "default_object_spacing_m": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Default Object Spacing M",
            "default": 3.0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "WorldScaleProfile",
        "description": "Project-wide spatial conventions shared by assets and scene assembly."
      }
    }
  }
}
