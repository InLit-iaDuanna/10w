{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sceneops.dev/schemas/forge-shell/module-manifest-v1.schema.json",
  "title": "Forge Shell module manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "version", "title", "description", "status", "feature_flag", "docking_engine",
    "requires", "contributes", "permissions", "entrypoints"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "const": "forge-shell" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "status": { "const": "active" },
    "feature_flag": { "const": "forge_shell" },
    "docking_engine": { "const": "dockview-react" },
    "requires": { "$ref": "#/$defs/requirements" },
    "contributes": { "$ref": "#/$defs/contributions" },
    "permissions": { "$ref": "#/$defs/uniqueStrings" },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frontend"],
      "properties": { "frontend": { "const": "./frontend/src/index.ts" } }
    }
  },
  "$defs": {
    "uniqueStrings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modules", "integrations", "optional_integrations"],
      "properties": {
        "modules": { "$ref": "#/$defs/uniqueStrings" },
        "integrations": { "$ref": "#/$defs/uniqueStrings" },
        "optional_integrations": { "$ref": "#/$defs/uniqueStrings" }
      }
    },
    "contributions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "editors", "commands", "events", "workspace_presets", "jobs", "workflows", "policy_gates"
      ],
      "properties": {
        "editors": { "$ref": "#/$defs/uniqueStrings" },
        "commands": { "$ref": "#/$defs/uniqueStrings" },
        "events": { "$ref": "#/$defs/uniqueStrings" },
        "workspace_presets": { "$ref": "#/$defs/uniqueStrings" },
        "jobs": { "$ref": "#/$defs/uniqueStrings" },
        "workflows": { "$ref": "#/$defs/uniqueStrings" },
        "policy_gates": { "$ref": "#/$defs/uniqueStrings" }
      }
    }
  }
}
