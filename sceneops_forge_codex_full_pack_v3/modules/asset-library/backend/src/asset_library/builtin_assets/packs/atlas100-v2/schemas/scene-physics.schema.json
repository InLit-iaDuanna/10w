{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atlas100 v2 scene-physics",
  "type": "object",
  "required": [
    "schema_version",
    "scene_id",
    "units",
    "objects",
    "gravity_m_s2"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "units": {
      "const": "meter"
    },
    "objects": {
      "type": "array",
      "minItems": 38,
      "maxItems": 38,
      "items": {
        "type": "object",
        "required": [
          "sceneops_id",
          "asset_id",
          "asset_version",
          "position_m",
          "rotation_euler_rad",
          "scale"
        ],
        "properties": {
          "sceneops_id": {
            "type": "string",
            "minLength": 1
          },
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "asset_version": {
            "const": "2.0.0"
          },
          "position_m": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "rotation_euler_rad": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "scale": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "runtime_instantiated": {
            "const": false
          }
        }
      }
    },
    "gravity_m_s2": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    }
  }
}
