  "components": {
    "schemas": {
      "AdoptBuiltinAsset": {
        "properties": {
          "project_id": {
            "type": "string",
            "minLength": 1,
            "title": "Project Id"
          },
          "card_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Card Id"
          }
        },
        "type": "object",
        "required": [
          "project_id"
        ],
        "title": "AdoptBuiltinAsset"
      },
      "BuiltinAsset": {
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$",
            "title": "Asset Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "kind": {
            "type": "string",
            "enum": [
              "prop",
              "character",
              "scene"
            ],
            "title": "Kind"
          },
          "pack_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$",
            "title": "Pack Id"
          },
          "pack_title": {
            "type": "string",
            "title": "Pack Title"
          },
          "pack_version": {
            "type": "string",
            "title": "Pack Version"
          },
          "license": {
            "type": "string",
            "title": "License"
          },
          "category": {
            "type": "string",
            "title": "Category",
            "default": ""
          },
          "asset_category": {
            "type": "string",
            "title": "Asset Category",
            "default": ""
          },
          "art_style": {
            "type": "string",
            "title": "Art Style",
            "default": "低多边形"
          },
          "game_genres": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Game Genres"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tags"
          },
          "reusable_asset_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reusable Asset Ids"
          },
          "generation_prompt": {
            "type": "string",
            "title": "Generation Prompt",
            "default": ""
          },
          "style_prompts": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Style Prompts"
          },
          "sprite_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sprite Url"
          },
          "sprite_layout": {
            "additionalProperties": true,
            "type": "object",
            "title": "Sprite Layout"
          },
          "rig": {
            "additionalProperties": true,
            "type": "object",
            "title": "Rig"
          },
          "rig_source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rig Source Url"
          },
          "shared_motion_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Shared Motion Url"
          },
          "rig_template_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rig Template Url"
          },
          "animations": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Animations"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "default": ""
          },
          "dimensions_m": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Dimensions M"
          },
          "footprint_m": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Footprint M"
          },
          "spawn_points": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Spawn Points"
          },
          "lighting": {
            "additionalProperties": true,
            "type": "object",
            "title": "Lighting"
          },
          "triangle_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Triangle Count"
          },
          "lods": {
            "items": {
              "$ref": "#/components/schemas/BuiltinAssetLod"
            },
            "type": "array",
            "title": "Lods"
          },
          "physics_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Physics Url"
          },
          "scene_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scene Url"
          },
          "uv_sets": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Uv Sets"
          },
          "material_channels": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Material Channels"
          },
          "embedded_texture_resolution": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Embedded Texture Resolution"
          },
          "source_texture_resolution": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Texture Resolution"
          },
          "preview_source": {
            "type": "string",
            "enum": [
              "asset",
              "scene"
            ],
            "title": "Preview Source",
            "default": "asset"
          },
          "preview_note": {
            "type": "string",
            "title": "Preview Note",
            "default": ""
          },
          "runtime": {
            "additionalProperties": true,
            "type": "object",
            "title": "Runtime"
          },
          "provenance": {
            "additionalProperties": true,
            "type": "object",
            "title": "Provenance"
          },
          "asset_url": {
            "type": "string",
            "title": "Asset Url"
          },
          "preview_url": {
            "type": "string",
            "title": "Preview Url"
          },
          "mode": {
            "type": "string",
            "const": "cached",
            "title": "Mode",
            "default": "cached"
          }
        },
        "type": "object",
        "required": [
          "asset_id",
          "label",
          "kind",
          "pack_id",
          "pack_title",
          "pack_version",
          "license",
          "dimensions_m",
          "footprint_m",
          "asset_url",
          "preview_url"
        ],
        "title": "BuiltinAsset"
      },
      "BuiltinAssetLod": {
        "properties": {
          "level": {
            "type": "integer",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Level"
          },
          "triangle_count": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Triangle Count"
          },
          "distance_m": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Distance M"
          },
          "asset_url": {
            "type": "string",
            "title": "Asset Url"
          }
        },
        "type": "object",
        "required": [
          "level",
          "asset_url"
        ],
        "title": "BuiltinAssetLod"
      },
      "BuiltinCatalog": {
        "properties": {
          "pack_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$",
            "title": "Pack Id"
          },
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "license": {
            "type": "string",
            "title": "License"
          },
          "packs": {
            "items": {
              "$ref": "#/components/schemas/BuiltinPackSummary"
            },
            "type": "array",
            "title": "Packs"
          },
          "entries": {
            "items": {
              "$ref": "#/components/schemas/BuiltinAsset"
            },
            "type": "array",
            "title": "Entries"
          }
        },
        "type": "object",
        "required": [
          "pack_id",
          "version",
          "title",
          "description",
          "license",
          "packs",
          "entries"
        ],
        "title": "BuiltinCatalog"
      },
      "BuiltinPackSummary": {
        "properties": {
          "pack_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$",
            "title": "Pack Id"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "license": {
            "type": "string",
            "title": "License"
          },
          "entry_count": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Entry Count"
          },
          "catalog_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Catalog Url"
          },
          "resource_base_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resource Base Url"
          }
        },
        "type": "object",
        "required": [
          "pack_id",
          "version",
          "title",
          "description",
          "license",
          "entry_count"
        ],
        "title": "BuiltinPackSummary"
      },
      "DoorMaterial": {
        "properties": {
          "color_hex": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$",
            "title": "Color Hex",
            "default": "#6B4F3A"
          },
          "roughness": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Roughness",
            "default": 0.75
          },
          "metalness": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Metalness",
            "default": 0.05
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "DoorMaterial"
      },
      "DoorRecipe": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "door-v1",
            "title": "Kind",
            "default": "door-v1"
          },
          "seed": {
            "type": "integer",
            "const": 0,
            "title": "Seed",
            "default": 0
          },
          "width_m": {
            "type": "number",
            "maximum": 10.0,
            "minimum": 0.2,
            "title": "Width M",
            "default": 1.2
          },
          "height_m": {
            "type": "number",
            "maximum": 10.0,
            "minimum": 0.5,
            "title": "Height M",
            "default": 2.2
          },
          "thickness_m": {
            "type": "number",
            "maximum": 2.0,
            "minimum": 0.02,
            "title": "Thickness M",
            "default": 0.15
          },
          "material": {
            "$ref": "#/components/schemas/DoorMaterial"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "DoorRecipe",
        "description": "Editable source for the first supported procedural asset."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ProjectAssetEntry": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "project_id": {
            "type": "string",
